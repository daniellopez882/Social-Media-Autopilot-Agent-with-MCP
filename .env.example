# SocialPilot configuration. Copy to .env and fill in. .env is gitignored.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Mock mode is OFF unless you set this. When on, every node and tool returns
# labelled mock data and nothing is fetched or published. Refused in
# production.
MOCK_MODE=false

# Required outside development. Every route that reads or changes state needs
# it as X-API-Key.  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Model. Only OpenAI via crewai is wired.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Platform credentials. No live integration exists for any of these yet; a
# tool that would use one reports not_implemented whether or not it is set.
TWITTER_API_KEY=
META_ACCESS_TOKEN=
BUFFER_ACCESS_TOKEN=

# Pending approvals live in memory: expire after this many seconds, keep at
# most this many.
APPROVAL_TTL_SECONDS=86400
APPROVAL_MAX_PENDING=1000

# The API serves the dashboard itself, so this is normally empty. Set only if
# a page on another origin must call the API. Never a wildcard.
CORS_ALLOW_ORIGINS=

# Server binding (used by the container).
BIND_HOST=127.0.0.1
PORT=8000
